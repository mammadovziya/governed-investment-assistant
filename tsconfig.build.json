{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "scripts",
    "src/assistant-v3/index.ts",
    "src/assistant-v3/shadow-evaluator.ts",
    "src/assistant-v3/studio-*.ts",
    "src/assistant-v3/editor-overrides/**"
  ]
}
