# Put the real key in `.env.local`, never in this tracked example.
OPENAI_API_KEY=
# Docker Compose intentionally does not inject this file wholesale. Export the
# key into the invoking shell (or use an approved secret manager) before
# starting compose.internal-pilot.yml.
# The app rejects any other configured model so every Mastra agent is consistent.
OPENAI_MODEL=gpt-4o
OPENAI_ESCALATION_MODEL=gpt-4.1

# The default fictional profile enables the project-authored Demo Invest
# knowledge pack. Select generic to disable product-specific knowledge and
# guides while keeping general portfolio, market, and education capabilities.
ASSISTANT_PRODUCT_PROFILE=demo-invest
# Optional display-only overrides. These labels never influence routing,
# policy, evidence, or tool selection.
ASSISTANT_PUBLIC_BRAND_NAME=
ASSISTANT_PUBLIC_BRAND_MARK=
ASSISTANT_PUBLIC_PRODUCT_NAME=

# The zero-configuration public demo uses project-authored, offline synthetic
# quotes, history, and limited profiles. No third-party market endpoint is
# contacted automatically. Yahoo remains available only as an explicit
# development/test opt-in; verify your own access and redistribution rights
# before setting this to yahoo-development. Staging/production always ignore
# this choice and fail closed until a licensed production adapter is supplied.
ASSISTANT_DEMO_MARKET_PROVIDER=synthetic-offline
# The customer-production target boots with market/research/history unavailable
# and reports not-ready until every blocker is replaced by approved production
# dependencies.
ASSISTANT_RELEASE_TARGET=internal-pilot
# Optional private diagnostics guard for the internal pilot. Use a URL-safe
# 32-512 character secret from an approved secret manager; never place it in a
# URL or logs. When absent, detailed readiness and capability routes stay off.
ASSISTANT_INTERNAL_DIAGNOSTICS_TOKEN=
# Development uses a clearly labeled public local key when this is empty.
# Production refuses to start without a unique secret of at least 32 characters.
ASSISTANT_SIGNING_KEY=
# A timeout or failed grounding eval returns a labeled direct-provider fallback.
MARKET_AGENT_TIMEOUT_MS=15000
MODEL_TIMEOUT_MS=15000

# File-backed local persistence for non-workflow Mastra domains. Customer
# workflow snapshots use a separate process-local store so prompts, bearer
# tokens, and intermediate facts are never written here. Relative file: URLs
# are resolved against the npm project root even when Studio changes cwd.
MASTRA_STORAGE_URL=file:./.mastra-storage-private-v2.db
# Studio has a physically separate memory/non-workflow database. Its workflow
# snapshots are also process-local and cannot enumerate application runs.
MASTRA_STUDIO_STORAGE_URL=file:./.mastra-storage-studio-private-v3.db
# Full local Mastra observability (traces, metrics, logs, scores, and feedback)
# uses one Studio-owned DuckDB. The app sends scrubbed signals to Studio over an
# authenticated loopback bridge; it never opens a second DuckDB writer.
MASTRA_OBSERVABILITY_SHARED=true
MASTRA_OBSERVABILITY_PATH=.mastra-observability-shared.duckdb
MASTRA_STUDIO_OBSERVABILITY_PATH=.mastra-observability-shared.duckdb
# Reviewable code-source Editor files. Only existing tool descriptions are
# editable; the customer runtime does not load this directory.
MASTRA_STUDIO_EDITOR_CODE_PATH=src/assistant-v3/editor-overrides
# Local audit output is private runtime state and is ignored by git.
ASSISTANT_AUDIT_OUTBOX_PATH=.assistant-v3-audit.jsonl
# These embedded stores are for the private internal pilot only. Customer
# production requires approved remote HA storage and deployment-time migrations.
# Optional fictional Demo Invest pack: separate immutable/versioned governed index.
# Replace this corpus and these identifiers for a real downstream product.
KNOWLEDGE_VECTOR_URL=file:./.knowledge-vector.db
KNOWLEDGE_INDEX_NAME=demo_invest_knowledge_2026_07_29_v1
KNOWLEDGE_INDEX_GENERATION=demo-invest-2026-07-29-v1
KNOWLEDGE_MINIMUM_SCORE=0.08
# The Demo Invest example pack can accept allow-listed official publications in
# development. Production
# fails startup unless this is controlled and manifests contain the required
# Legal/Compliance/Product/Research approvals.
KNOWLEDGE_APPROVAL_MODE=official-publication
# Descriptive deployment metadata used by readiness checks and telemetry.
ASSISTANT_IDENTITY_MODE=mock-internal-pilot
ASSISTANT_PORTFOLIO_MODE=synthetic-ledger
MARKET_LICENCE_CLASS=synthetic
LOG_LEVEL=info
# Prometheus-compatible metric family prefix. Keep it stable after dashboards
# and alerts are created.
ASSISTANT_METRICS_PREFIX=investment_assistant
NODE_ENV=development

PORT=3000
MARKET_STREAM_INTERVAL_MS=1000
# Keep this below the stream interval so each tick can request a fresh snapshot.
MARKET_CACHE_MS=900
MARKET_TIMEOUT_MS=5000

# Process-local demo protection. Production should enforce distributed limits
# at the authenticated API gateway as well.
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000

# Bounded deterministic conversation continuity. This stores only a signed,
# session-bound set of up to two public symbols and a safe intent reference
# after an audited response succeeds. It never stores prompts, model output, portfolio facts,
# account data, or order state, and writer agents cannot read it as transcript
# memory. The pilot adapter is process-local and is not customer-production
# ready.
ASSISTANT_V3_CONVERSATION_MEMORY_ENABLED=true
ASSISTANT_V3_CONVERSATION_MEMORY_TTL_MS=300000
ASSISTANT_V3_CONVERSATION_MEMORY_MAX_ENTRIES=10000
ASSISTANT_V3_CONVERSATION_MEMORY_MAX_HOPS=3
